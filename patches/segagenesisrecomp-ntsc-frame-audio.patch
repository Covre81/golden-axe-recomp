     }
-    /* --target-fps wins over debug.ini, which wins over default 59.94. */
+    /* --target-fps wins over debug.ini, which wins over the default: the real
+     * NTSC frame rate, master 53693175 Hz / (262 x 3420) = 59.9227 fps. Must
+     * match GENESIS_SIM_WALL_FRAME_MASTER_CYCLES (sim_step.c) or the audio
+     * buffer drifts and the DRC has to absorb it. */
     double target_fps = (target_fps_cli > 0.0)     ? target_fps_cli :
                         (target_fps_from_ini > 0.0) ? target_fps_from_ini :
-                                                       (60000.0 / 1001.0);  /* NTSC */
+                                                       (53693175.0 / 896040.0);  /* NTSC */
     fprintf(stderr, "[pacer] target frame rate: %.4f fps\n", target_fps);
     int debug_port = debug_port_cli ? debug_port_cli :
                      (debug_port_from_ini ? debug_port_from_ini :
diff --git a/runner/sim_step.c b/runner/sim_step.c
index 5bbef5f..c3d5436 100644
--- a/runner/sim_step.c
+++ b/runner/sim_step.c
@@ -12,8 +12,12 @@
 
 /* One NTSC wall frame of master cycles: the audio chips advance this far every
  * tick whatever the 68K did (see main.c's comment history on why the drain is
- * the wall frame, not g_audio_cycle_counter). */
-#define GENESIS_SIM_WALL_FRAME_MASTER_CYCLES 895780u
+ * the wall frame, not g_audio_cycle_counter). Hardware: 262 lines x 3420
+ * master = 896040 (59.9227 Hz, ~3733.5 PSG samples per frame). The old 895780
+ * was the 59.94 Hz host-pacer rate (~3732 samples), so every frame of audio
+ * came out ~0.03% short of the console's. Keep in step with main.c's default
+ * target fps. */
+#define GENESIS_SIM_WALL_FRAME_MASTER_CYCLES 896040u
 
 /* glue.c frame bookkeeping (not in glue.h; main.c historically declared
  * them at the call site). */
