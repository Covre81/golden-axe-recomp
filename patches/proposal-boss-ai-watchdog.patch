diff --git a/game/goldenaxe_spec.c b/game/goldenaxe_spec.c
index 8ad9655..53edb25 100644
--- a/game/goldenaxe_spec.c
+++ b/game/goldenaxe_spec.c
@@ -235,6 +235,64 @@ static int ga_is_scripted_noinput_entry(uint16_t state42)
 #define GA_FLAGS3_CUTSCENE_RETRIGGER_BIT 0x40u
 #define GA_FLAGS2_ONESHOT_LATCH_BIT      0x04u
 
+/* ---- Optional Bad Brothers ($C0) AI watchdog, OFF by default ----
+ * Enable with "boss_ai_watchdog=1" in goldenaxe-video.ini.
+ * The ROM can park a brother in loc_1073C/loc_10782 ($4C&$7F == $0C, $4E bit 6 set)
+ * calling loc_BF48 every frame and waiting for player contact ($03 bit 6), and the
+ * partner can loop $04 -> $08 (attack) -> no contact forever. This post-VBlank hook
+ * only touches enemy slots $FFD100/$FFD180 whose ID byte is $C0 and anim script is
+ * loc_40262, and writes $4C=$04 exactly like the ROM does at loc_108D4. */
+#define GA_BB_SLOT_A        0x00FFD100u
+#define GA_BB_SLOT_B        0x00FFD180u
+#define GA_BB_ID            0xC0u
+#define GA_BB_ANIM_SCRIPT   0x00040262u
+#define GA_BB_WAIT_FRAMES   120u
+#define GA_BB_ATK_STREAK    6u
+
+typedef struct { uint16_t wait; uint8_t streak; uint8_t prev; } GaBbWd;
+
+static void ga_bb_watchdog_one(uint32_t b, GaBbWd *s)
+{
+    if (m68k_read8(b) != GA_BB_ID || m68k_read32(b + 0x6Cu) != GA_BB_ANIM_SCRIPT) {
+        s->wait = 0; s->streak = 0; s->prev = 0xFFu; return;
+    }
+    uint8_t st = (uint8_t)(m68k_read8(b + 0x4Cu) & 0x7Fu);
+    uint8_t f3 = m68k_read8(b + 0x03u);
+    uint8_t f4e = m68k_read8(b + 0x4Eu);
+    /* stuck in loc_10782: $0C with $4E bit 6 set and no contact ($03 bits 6/1 clear) */
+    if (st == 0x0Cu && (f4e & 0x40u) && !(f3 & 0x42u)) {
+        if (++s->wait >= GA_BB_WAIT_FRAMES) {
+            m68k_write8(b + 0x4Cu, 0x04u);
+            s->wait = 0;
+        }
+    } else {
+        s->wait = 0;
+    }
+    /* $04 -> $08 -> $04 loop: loc_BEFE says "in range" but the attack hitbox
+     * (loc_BF62) never overlaps the player. Forcing $04 would change nothing
+     * (the ROM already returns to $04 at loc_108D4), so after N whiffs nudge
+     * the brother 4 px along X ($1C) toward player 1 so the next swing can land. */
+    if (st == 0x08u && s->prev != 0x08u) {
+        if (++s->streak >= GA_BB_ATK_STREAK) {
+            uint16_t bx = m68k_read16(b + 0x1Cu);
+            uint16_t px = m68k_read16(0x00FFD01Cu);
+            m68k_write16(b + 0x1Cu, (uint16_t)(px > bx ? bx + 4u : bx - 4u));
+            s->streak = 0;
+        }
+    } else if (st == 0x0Cu && (f3 & 0x40u)) {
+        s->streak = 0;   /* real contact happened */
+    }
+    s->prev = st;
+}
+
+static void ga_bb_watchdog_tick(void)
+{
+    static GaBbWd a = {0, 0, 0xFFu}, b = {0, 0, 0xFFu};
+    if (!goldenaxe_boss_ai_watchdog_enabled()) return;
+    ga_bb_watchdog_one(GA_BB_SLOT_A, &a);
+    ga_bb_watchdog_one(GA_BB_SLOT_B, &b);
+}
+
 static void ga_call_vblank(void)
 {
     static uint16_t s_prev_p1_state42 = 0xFFFFu;  /* sentinel: no prior frame yet */
@@ -265,6 +323,8 @@ static void ga_call_vblank(void)
         if (flags2 & GA_FLAGS2_ONESHOT_LATCH_BIT)
             m68k_write8(GA_P1_BASE + 0x2u, (uint8_t)(flags2 & ~GA_FLAGS2_ONESHOT_LATCH_BIT));
     }
+
+    ga_bb_watchdog_tick();
 }
 
