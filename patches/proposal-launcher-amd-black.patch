diff --git a/recomp-ui/src/common/launcher_gl_health.c b/recomp-ui/src/common/launcher_gl_health.c
new file mode 100644
index 0000000..37d2068
--- /dev/null
+++ b/recomp-ui/src/common/launcher_gl_health.c
@@ -0,0 +1,52 @@
+// launcher_gl_health.c — OpenGL sanity checks (software GL, errors, black frame).
+
+#include "launcher_gl_health.h"
+
+#include "launcher_sdlcompat.h"
+
+#include <stdio.h>
+#include <string.h>
+
+static int renderer_is_software_str(const char* r) {
+    if (!r || !r[0]) return 1;
+    if (strstr(r, "GDI Generic")) return 1;
+    if (strstr(r, "Microsoft Generic") || strstr(r, "WARP")) return 1;
+    if (strstr(r, "Software Adapter") || strstr(r, "LLVMpipe")) return 1;
+    return 0;
+}
+
+void launcher_gl_log_info(void) {
+    const char* version = (const char*)glGetString(GL_VERSION);
+    const char* vendor  = (const char*)glGetString(GL_VENDOR);
+    const char* renderer = (const char*)glGetString(GL_RENDERER);
+    fprintf(stderr, "[launcher] GL version=%s vendor=%s renderer=%s\n",
+            version ? version : "(null)",
+            vendor ? vendor : "(null)",
+            renderer ? renderer : "(null)");
+    (void)launcher_gl_poll_error("post-glGetString");
+}
+
+bool launcher_gl_renderer_is_software(void) {
+    const char* renderer = (const char*)glGetString(GL_RENDERER);
+    return renderer_is_software_str(renderer) != 0;
+}
+
+bool launcher_gl_poll_error(const char* tag) {
+    GLenum err = glGetError();
+    if (err == GL_NO_ERROR) return false;
+    fprintf(stderr, "[launcher] glGetError(%s)=0x%x\n", tag ? tag : "?", (unsigned)err);
+    return true;
+}
+
+bool launcher_gl_frame_has_visible_pixels(int pixel_w, int pixel_h) {
+    unsigned char px[4];
+    int x, y;
+    if (pixel_w <= 0 || pixel_h <= 0) return false;
+    x = pixel_w / 2;
+    y = pixel_h / 2;
+    glReadPixels(x, y, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, px);
+    if (launcher_gl_poll_error("glReadPixels")) return false;
+    /* Background clear is dark blue-grey (~0.04,0.05,0.08); true black swap
+     * failure reads as 0,0,0,0 on many AMD multi-monitor setups. */
+    return px[0] > 4 || px[1] > 4 || px[2] > 4;
+}
diff --git a/recomp-ui/src/common/launcher_gl_health.h b/recomp-ui/src/common/launcher_gl_health.h
new file mode 100644
index 0000000..a8eed8b
--- /dev/null
+++ b/recomp-ui/src/common/launcher_gl_health.h
@@ -0,0 +1,29 @@
+// launcher_gl_health.h — lightweight OpenGL sanity checks for the launcher.
+
+#ifndef LAUNCHER_GL_HEALTH_H
+#define LAUNCHER_GL_HEALTH_H
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Log GL_VERSION / GL_VENDOR / GL_RENDERER to stderr. Requires current context.
+void launcher_gl_log_info(void);
+
+// True when the driver is a known software rasterizer (GDI Generic, etc.).
+bool launcher_gl_renderer_is_software(void);
+
+// True when glGetError reports an error after `tag` (also logs the GLenum).
+bool launcher_gl_poll_error(const char* tag);
+
+// After a frame is drawn, sample the framebuffer centre. Returns false when
+// every channel is near zero (likely black-screen failure).
+bool launcher_gl_frame_has_visible_pixels(int pixel_w, int pixel_h);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* LAUNCHER_GL_HEALTH_H */
